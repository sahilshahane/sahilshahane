---
import { REV, BUILT } from '../lib/build';

interface Props {
  /** What goes in the title block's SHEET cell. */
  sheet?: string;
}
const { sheet = '04 / 04' } = Astro.props;
---
<div class="wrap"><footer>
  <div class="titleblock">
    <div><small>Drawn by</small><b>Sahil Shahane</b></div>
    <div><small>Rev</small><b>{REV}</b></div>
    <div><small>Date</small><b>{BUILT}</b></div>
    <div><small>Sheet</small><b>{sheet}</b></div>
    <div><small>Links</small><a href="https://github.com/sahilshahane" target="_blank" rel="noopener">GitHub</a> · <a href="https://linkedin.com/in/sahilshahane" target="_blank" rel="noopener">LinkedIn</a> · <a href="mailto:sahilpshahane123@gmail.com">Email</a></div>
  </div>
  <div class="foot-note">
    <span>© <span id="yr">2026</span> Sahil Shahane</span>
    <span>Built with Astro · no trackers · scale 1:1</span>
  </div>
</footer></div>

<script>
  const yr = document.getElementById('yr');
  if (yr) yr.textContent = String(new Date().getFullYear());
</script>
