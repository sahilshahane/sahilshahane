---
/* An isometric exploded view of the kind of system the rest of the page is
   about, one plate per layer. Plates are drawn flat (plan view) and projected
   with the isometric matrix, so everything on a plate's top face is authored
   in plain x/y. main.js spreads the plates apart as the hero scrolls
   ("takes systems apart") and packs them back together on the way up. */

const C = 0.8660254;         // cos 30°
const S = 90;                // plate half-size, plan units
const T = 12;                // plate thickness
const R = +(2 * S * C).toFixed(1);  // screen x of the right/left corners
const ISO = `matrix(${C} .5 ${-C} .5 0 0)`;

const top = `M0 ${-S}L${R} 0L0 ${S}L${-R} 0Z`;
const left = `M${-R} 0L0 ${S}L0 ${S + T}L${-R} ${T}Z`;
const right = `M0 ${S}L${R} 0L${R} ${T}L0 ${S + T}Z`;

// top to bottom; `plan` is drawn in plan units on the plate's top face
const layers = [
  {
    n: 'L1', name: 'Client', tech: 'Next.js · React · TS',
    plan: `<rect x="-70" y="-64" width="140" height="120" rx="5"/>
      <path d="M-70 -48H70"/>
      <circle cx="-61" cy="-56" r="2.6"/><circle cx="-53" cy="-56" r="2.6"/><circle cx="-45" cy="-56" r="2.6"/>
      <rect x="-34" y="-60" width="94" height="8" rx="4"/>
      <rect class="acc" x="-58" y="-36" width="58" height="9"/>
      <path d="M-58 -16H44M-58 -6H54M-58 4H30"/>
      <rect x="-58" y="18" width="52" height="28"/><rect x="2" y="18" width="52" height="28"/>
      <text x="-68" y="76">app/page.tsx</text>`,
  },
  {
    n: 'L2', name: 'Auth & access', tech: 'OAuth 2.0 · OIDC · RBAC',
    plan: `<rect class="dash" x="-76" y="-76" width="152" height="152"/>
      <path d="M0 -76V-48M0 48V76M-76 0H-48M48 0H76"/>
      <rect x="-44" y="-44" width="88" height="88" rx="4"/>
      ${[0, 1, 2, 3].map((r) => [0, 1, 2, 3].map((c) =>
        `<rect${(r * 5 + c * 3) % 4 === 0 || r === c ? ' class="acc"' : ''} x="${-32 + c * 17}" y="${-32 + r * 17}" width="12" height="12"/>`).join('')).join('')}
      <text x="-44" y="-54">oidc · rbac</text>`,
  },
  {
    n: 'L3', name: 'Services', tech: 'Billing · Stripe · Go · .NET',
    plan: `<rect x="-74" y="-72" width="64" height="52"/><text x="-68" y="-42">billing</text>
      <rect x="10" y="-72" width="64" height="52"/><text x="16" y="-42">api</text>
      <rect class="acc-o" x="-74" y="0" width="148" height="48"/><text x="-68" y="28">k8s-controller</text>
      <path d="M-42 -20V0M42 -20V0M-10 -46H10"/>
      <text x="-74" y="74">6+ products · 1 bill</text>`,
  },
  {
    n: 'L4', name: 'Data', tech: 'Redis in Rust · Postgres · S3',
    plan: `<circle cx="-36" cy="-34" r="28"/><circle class="dash" cx="-36" cy="-34" r="19"/><text x="-54" y="-30">redis</text>
      <circle cx="38" cy="-34" r="28"/><text x="28" y="-30">pg</text>
      <circle cx="0" cy="42" r="28"/><text x="-8" y="46">s3</text>
      <path d="M-8 -34H10M-22 -9L-12 17M24 -9L14 17"/>`,
  },
  {
    n: 'L5', name: 'Infrastructure', tech: 'Kubernetes · Docker · Nginx',
    plan: `${[0, 1, 2, 3].map((r) => [0, 1, 2, 3].map((c) =>
        `<rect${(r * 7 + c * 5) % 5 === 1 ? ' class="acc"' : ''} x="${-72 + c * 38}" y="${-72 + r * 36}" width="30" height="28"/>`).join('')).join('')}
      <text x="-72" y="84">16 pods · 4 nodes</text>`,
  },
];
const N = layers.length;
const GAP0 = 26;   // resting spacing — must match main.js
const y0 = (i: number) => ((i - (N - 1) / 2) * GAP0).toFixed(1);
---
<figure class="fig r" id="stack" style="--d:2">
  <svg class="iso" viewBox="-178 -290 530 590" role="img"
    aria-label={`Isometric diagram of a system stack in ${N} layers: ${layers.map((L) => `${L.name} (${L.tech})`).join(', ')}`}>
    <defs>
      <pattern id="hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect width="6" height="6" style="fill:var(--bg)"/>
        <path d="M0 0V6" style="stroke:var(--line-2)" stroke-width="1.2"/>
      </pattern>
    </defs>

    <!-- assembly lines: where each plate came from -->
    <g class="asm">
      <line x1={-R} x2={-R}/><line x1="0" x2="0"/><line x1={R} x2={R}/>
    </g>
    <!-- requests going down the front edge, responses coming back up the right -->
    <g class="packets">
      {layers.slice(1).map(() => <rect class="pk dn" width="5" height="5" x="-2.5" y="-2.5"/>)}
      {layers.slice(1).map(() => <rect class="pk up" width="5" height="5" x="-2.5" y="-2.5"/>)}
    </g>

    {layers.map((_, j) => {
      const i = N - 1 - j;         // paint bottom plate first so upper plates cover it
      const L = layers[i];
      return (
        <g class="layer" data-i={i} transform={`translate(0 ${y0(i)})`}>
          <g class="drop" style={`--k:${N - 1 - i}`}>
            <path class="side" d={left}/>
            <path class="side r" d={right}/>
            <path class="top" d={top}/>
            <g class="plan" transform={ISO} set:html={L.plan}></g>
          </g>
        </g>
      );
    })}

    <!-- callouts, one per plate, drawn over everything -->
    {layers.map((L, i) => (
      <g class="callout" data-i={i} transform={`translate(0 ${y0(i)})`}>
        <circle cx={R} cy="0" r="2.6"/>
        <path d={`M${R + 4} 0H${R + 32}`}/>
        <text class="cn" x={R + 38} y="-3">{L.n} · {L.name.toUpperCase()}</text>
        <text class="ct" x={R + 38} y="12">{L.tech}</text>
      </g>
    ))}

    <!-- overall height dimension, live -->
    <g class="dim">
      <line class="dl" x1="-170" x2="-170"/>
      <path class="t1"/><path class="t2"/>
      <text class="dv" x="-176" y="0" transform="rotate(-90 -176 0)"></text>
    </g>
  </svg>
  <figcaption id="stackCap">
    <span>FIG. 01 — system stack, isometric</span>
    <span class="xp-read">exploded <b id="stackPct">0%</b></span>
  </figcaption>
</figure>
