---
interface Props {
  title: string;
  description: string;
  /** Path relative to the site root, e.g. '' or 'blog/' */
  path?: string;
  ogImage: string;
  ogImageAlt: string;
  ogType?: string;
  robots?: string;
  keywords?: string;
}

const {
  title,
  description,
  path = '',
  ogImage,
  ogImageAlt,
  ogType = 'website',
  robots = 'index, follow',
  keywords,
} = Astro.props;

// Full URLs are required here (canonical, Open Graph); everything else is relative.
const canonical = new URL(path, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
const favicon = `data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='22' fill='%230b0b0e'/><text y='68' x='50' text-anchor='middle' font-family='system-ui,sans-serif' font-size='54' font-weight='700' fill='%237aa2ff'>S</text></svg>`;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={description}>
{keywords && <meta name="keywords" content={keywords}>}
<meta name="author" content="Sahil Shahane">
<meta name="robots" content={robots}>
<meta name="theme-color" content="#08080a">
<link rel="canonical" href={canonical}>

<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:type" content={ogType}>
<meta property="og:url" content={canonical}>
<meta property="og:site_name" content="Sahil Shahane">
<meta property="og:image" content={ogImageUrl}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={ogImageAlt}>
<meta property="og:locale" content="en_US">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={ogImageUrl}>

<link rel="icon" href={favicon}>
<link rel="sitemap" href="/sitemap.xml">
<slot name="head" />
<script is:inline>
  document.documentElement.className="js";
  // Apply the saved theme before first paint (the toggle lives in Nav.astro).
  try{var t=localStorage.getItem("theme");if(t)document.documentElement.dataset.theme=t;}catch(e){}
</script>
</head>
<body>
<slot />
</body>
</html>
